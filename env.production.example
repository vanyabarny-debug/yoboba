# Скопируй в .env на сервере и заполни реальными значениями.
# ВАЖНО: NEXT_PUBLIC_* запекаются в сборку — при их изменении нужно пересобрать образ.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Публичный адрес сайта (для VK redirect и ссылок в письмах)
NEXT_PUBLIC_SITE_URL=https://yomoyo.su

# VK ID (кабинет id.vk.ru → ID приложения)
NEXT_PUBLIC_VK_CLIENT_ID=54721109
# для web + PKCE не обязателен
VK_CLIENT_SECRET=
